@keyframes ms-motion-fadeIn {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes ms-motion-fadeOut {=20
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes ms-motion-scaleDownIn {=20
  0% { transform: scale3d(1.15, 1.15, 1); }
  100% { transform: scale3d(1, 1, 1); }
}

@keyframes ms-motion-scaleDownOut {=20
  0% { transform: scale3d(1, 1, 1); }
  100% { transform: scale3d(0.9, 0.9, 1); }
}

@keyframes ms-motion-slideLeftOut {=20
  0% { transform: translate3d(0px, 0px, 0px); }
  100% { transform: translate3d(-48px, 0px, 0px); }
}

@keyframes ms-motion-slideRightOut {=20
  0% { transform: translate3d(0px, 0px, 0px); }
  100% { transform: translate3d(48px, 0px, 0px); }
}

@keyframes ms-motion-slideLeftIn {=20
  0% { transform: translate3d(48px, 0px, 0px); }
  100% { transform: translate3d(0px, 0px, 0px); }
}

@keyframes ms-motion-slideRightIn {=20
  0% { transform: translate3d(-48px, 0px, 0px); }
  100% { transform: translate3d(0px, 0px, 0px); }
}

@keyframes ms-motion-slideUpOut {=20
  0% { transform: translate3d(0px, 0px, 0px); }
  100% { transform: translate3d(0px, -48px, 0px); }
}

@keyframes ms-motion-slideDownOut {=20
  0% { transform: translate3d(0px, 0px, 0px); }
  100% { transform: translate3d(0px, 48px, 0px); }
}

@keyframes ms-motion-slideUpIn {=20
  0% { transform: translate3d(0px, 48px, 0px); }
  100% { transform: translate3d(0px, 0px, 0px); }
}

@keyframes ms-motion-slideDownIn {=20
  0% { transform: translate3d(0px, -48px, 0px); }
  100% { transform: translate3d(0px, 0px, 0px); }
}

